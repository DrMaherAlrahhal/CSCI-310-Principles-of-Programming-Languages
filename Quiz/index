<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CSCI 310 | Interactive Revision Hub</title><style>
:root{font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:#e8f1ff;background:#071321}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top left,#183e60 0%,#071321 50%);min-height:100vh}button,select,textarea{font:inherit}button{cursor:pointer}header,.wrap{max-width:1120px;margin:auto;padding:24px}header{display:flex;justify-content:space-between;align-items:center;gap:16px}.brand{font-weight:850;letter-spacing:.05em;color:#8bdff2}.chip{background:#193650;border:1px solid #326080;border-radius:50px;padding:9px 14px;font-size:13px}.hero{padding:35px 0 23px}.eyebrow{color:#5ce4cb;font-weight:750;font-size:13px;text-transform:uppercase;letter-spacing:.14em}h1{font-size:clamp(32px,5vw,58px);line-height:1.08;margin:12px 0}p{color:#aebfd2;line-height:1.65}.hero p{max-width:700px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:25px 0}.stat,.panel,.question-card{background:#10263b;border:1px solid #28475f;border-radius:19px;padding:20px}.stat strong{font-size:27px;display:block}.stat span{color:#aebfd2;font-size:13px}.tabs{display:flex;gap:10px;flex-wrap:wrap;margin:24px 0}.tabs button,.smallbtn{border:1px solid #345773;background:#142c43;color:#e6f3ff;border-radius:11px;padding:12px 16px}.tabs button.active,.primary{background:#3ad5bb!important;color:#06232a!important;border-color:#3ad5bb!important;font-weight:800}.controls{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}.controls select{background:#0b1d2e;color:white;padding:12px;border:1px solid #345773;border-radius:10px;max-width:100%}.progress{height:10px;background:#213d52;border-radius:20px;overflow:hidden;margin:17px 0}.progress>div{height:100%;background:linear-gradient(90deg,#3ad5bb,#5eabff);transition:width .2s}.muted{color:#a9bfd1;font-size:14px}.question-card{margin-top:17px;padding:26px}.qtop{display:flex;justify-content:space-between;gap:15px;color:#64d8cc;font-size:13px;font-weight:750}.question-card h2{font-size:clamp(19px,2.6vw,26px);line-height:1.45;margin:22px 0;white-space:pre-wrap}.option{display:flex;text-align:left;align-items:flex-start;gap:14px;width:100%;padding:16px;margin:11px 0;border-radius:13px;border:1px solid #36546b;background:#152d43;color:#eef7ff;transition:.15s;white-space:pre-wrap}.option:hover:not(:disabled){border-color:#64d8cc;background:#1b3a50}.option b{background:#2a4961;padding:5px 10px;border-radius:8px}.option.correct{border-color:#43e6a0;background:#164738}.option.wrong{border-color:#ff8585;background:#522d3b}.option:disabled{cursor:default}.feedback{border-radius:12px;background:#1a3d47;padding:15px;margin-top:16px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}.primary{border:0;border-radius:11px;padding:13px 20px}.hidden{display:none!important}.written{display:grid;gap:15px;margin-top:20px}.written details{background:#10263b;border:1px solid #28475f;border-radius:15px;padding:18px}.written summary{cursor:pointer;font-weight:750;line-height:1.5}.written textarea{width:100%;min-height:120px;background:#071b2b;color:white;border:1px solid #345773;border-radius:10px;padding:14px;margin-top:15px}.answer{white-space:pre-wrap;background:#18384a;border-left:3px solid #3ad5bb;padding:16px;border-radius:7px;line-height:1.65;margin-top:15px}.foot{padding:28px;text-align:center;color:#9db4c5;font-size:13px}@media(max-width:600px){.stats{grid-template-columns:1fr 1fr}.stat:last-child{grid-column:span 2}.question-card{padding:18px}header{padding-bottom:0}}
</style></head><body><header><div class="brand">CSCI 310 · PPL</div><div class="chip">Interactive Study Hub</div></header><main class="wrap"><section class="hero"><div class="eyebrow">Principles of Programming Languages</div><h1>Learn. Practice.<br>Master the concepts.</h1><p>Review programming language foundations, evaluation criteria, and Scheme/Lisp. Answer questions, get immediate feedback, and check your progress.</p></section><div class="stats"><div class="stat"><strong>47</strong><span>Multiple-choice questions</span></div><div class="stat"><strong>9</strong><span>Written practice tasks</span></div><div class="stat"><strong id="scoreTop">0 / 0</strong><span>Correct / attempted</span></div></div><nav class="tabs"><button class="active" data-tab="quiz">✦ MCQ Practice</button><button data-tab="written">✎ Written Questions</button><button data-tab="results">▤ My Results</button></nav><section id="quiz"><div class="panel"><div class="controls"><label>Choose module: <select id="module"><option value="All">All modules (47)</option><option>Foundations</option><option>Language Evaluation</option><option>Scheme & Lisp</option></select></label><div><button class="smallbtn" id="shuffle">Shuffle questions</button> <button class="smallbtn" id="restart">Reset practice</button></div></div><div class="progress"><div id="bar" style="width:0%"></div></div><div class="muted" id="progressText"></div></div><div class="question-card" id="questionCard"><div class="qtop"><span id="sectionLabel"></span><span id="numberLabel"></span></div><h2 id="prompt"></h2><div id="options"></div><div id="feedback" class="feedback hidden" aria-live="polite"></div><div class="actions"><button class="smallbtn" id="prev">← Previous</button><button class="primary" id="next">Next question →</button></div></div></section><section id="written" class="hidden"><div class="panel"><h2>Written-answer practice</h2><p>Think through each task, write your own response, then reveal a suggested answer to compare. Your draft remains on this device while the page is open.</p></div><div id="writtenList" class="written"></div></section><section id="results" class="hidden"><div class="panel"><h2>Your learning progress</h2><h1 id="finalScore">0%</h1><p id="resultText"></p><div id="breakdown"></div><div class="actions"><button class="primary" id="review">Continue practicing</button><button class="smallbtn" id="resetResults">Start again</button></div></div></section></main><footer class="foot">CSCI 310 · Student revision resource · Answers appear after selection · Works offline</footer><script>
const QUESTIONS=[{"q": "Why do we need programming languages?", "options": ["Replace hardware", "Express solutions in a structured form", "Avoid checking logic", "Use the same algorithm for every problem"], "answer": 1, "section": "Foundations"}, {"q": "Why does a CPU not directly execute Python source code?", "options": ["Python has no variables", "CPUs execute machine instructions, not Python syntax", "Python runs only online", "Python is assembly language"], "answer": 1, "section": "Foundations"}, {"q": "Which sequence describes the path from an idea to a result?", "options": ["Result → Code → Problem", "Problem → Program → Execution → Result", "CPU → Problem → Result", "Result → Compiler → Problem"], "answer": 1, "section": "Foundations"}, {"q": "What distinguishes a compiler from an interpreter?", "options": ["Only compilers execute programs", "A compiler translates code; an interpreter executes through interpretation", "Interpreters cannot process code", "Compilers guarantee correct results"], "answer": 1, "section": "Foundations"}, {"q": "Why choose Python for an AI application?", "options": ["CPUs only support Python", "Useful libraries and ML ecosystem", "Python never needs testing", "Python understands every problem"], "answer": 1, "section": "Foundations"}, {"q": "Which paradigm focuses on functions and transformations?", "options": ["Object-oriented", "Functional", "Imperative", "Logic"], "answer": 1, "section": "Foundations"}, {"q": "Which paradigm organizes programs around objects containing data and behavior?", "options": ["Logic", "Bottom-up", "Object-oriented", "Assembly"], "answer": 2, "section": "Foundations"}, {"q": "Which approach builds a solution by combining smaller components?", "options": ["Bottom-up", "Machine-code-only", "Logic-only", "Top-down execution"], "answer": 0, "section": "Foundations"}, {"q": "A program prints \"Safe\" for temperature 80, although above 70 is dangerous. What is wrong?", "options": ["Missing compiler", "Incorrect logic or semantics", "Invalid variable name", "CPU cannot compare"], "answer": 1, "section": "Foundations"}, {"q": "Which statement about AI-generated code is correct?", "options": ["Valid code is always correct", "AI code cannot execute", "Code must be checked against requirements", "AI removes the need to understand code"], "answer": 2, "section": "Foundations"}, {"q": "What should guide the choice of programming language?", "options": ["Shortest name", "Suitability for application requirements", "Most symbols", "Newest language"], "answer": 1, "section": "Language Evaluation"}, {"q": "Which criterion concerns how easily people understand code?", "options": ["Cost", "Reliability", "Readability", "Writability"], "answer": 2, "section": "Language Evaluation"}, {"q": "Which criterion concerns how easily developers express solutions?", "options": ["Writability", "Cost", "Reliability", "Execution speed"], "answer": 0, "section": "Language Evaluation"}, {"q": "Which criterion concerns dependable and correct behavior?", "options": ["Popularity", "Reliability", "Readability", "Short variable names"], "answer": 1, "section": "Language Evaluation"}, {"q": "Which criterion includes learning, development, testing, and maintenance resources?", "options": ["Grammar", "Readability", "Cost", "Scope"], "answer": 2, "section": "Language Evaluation"}, {"q": "Which expression is generally more readable?", "options": ["x = a * b", "total_price = price * quantity", "z = q * r", "t = p * n"], "answer": 1, "section": "Language Evaluation"}, {"q": "Why is readability important for long-lived software?", "options": ["CPU reads names faster", "Code needs future understanding and maintenance", "Readable code has no bugs", "No testing needed"], "answer": 1, "section": "Language Evaluation"}, {"q": "A built-in function makes a common operation easier to express. Which criterion improves?", "options": ["Writability", "Hardware cost", "Lexical ambiguity", "Machine-code length"], "answer": 0, "section": "Language Evaluation"}, {"q": "Which statement about readability and writability is correct?", "options": ["Shorter is always clearer", "Compact code may be easier to write but harder to read", "Readable code cannot be concise", "Writability means faster execution"], "answer": 1, "section": "Language Evaluation"}, {"q": "Two programs give the same result. One has descriptive names. What can we conclude?", "options": ["It must run faster", "It is likely more readable", "It uses less memory", "It is automatically more reliable"], "answer": 1, "section": "Language Evaluation"}, {"q": "Which language feature helps detect certain programming errors?", "options": ["Type checking", "Unpredictable behavior", "Ambiguous syntax", "No error messages"], "answer": 0, "section": "Language Evaluation"}, {"q": "Which criterion is especially important in banking systems?", "options": ["Reliability", "Popularity", "Number of keywords", "Editor color"], "answer": 0, "section": "Language Evaluation"}, {"q": "A language is easy to learn but requires expensive maintenance tools. What matters?", "options": ["Learning time only", "Total development and maintenance cost", "Compiler name", "Source length"], "answer": 1, "section": "Language Evaluation"}, {"q": "Why might a fast-running language still be expensive?", "options": ["Speed determines all costs", "Development and maintenance may be expensive", "Fast programs are unreliable", "It cannot have libraries"], "answer": 1, "section": "Language Evaluation"}, {"q": "Which statement best describes reliability?", "options": ["Programs are short", "Programs behave correctly and dependably", "Programs have no comments", "Programs are written quickly"], "answer": 1, "section": "Language Evaluation"}, {"q": "Why do programming languages evolve?", "options": ["Eliminate old programs", "Support new applications, hardware, and needs", "CPUs understand every language", "Remove grammar rules"], "answer": 1, "section": "Language Evaluation"}, {"q": "What can motivate new language features?", "options": ["New programming problems", "Using only one variable", "No hardware", "No program execution"], "answer": 0, "section": "Language Evaluation"}, {"q": "Which Python statement is syntactically valid?", "options": ["75 = mark", "mark = 75", "= mark 75", "mark 75 ="], "answer": 1, "section": "Language Evaluation"}, {"q": "What does programming language grammar describe?", "options": ["Development cost", "Rules for valid program structures", "Business purpose", "CPU temperature"], "answer": 1, "section": "Language Evaluation"}, {"q": "A program follows grammar rules but computes the wrong result. What does this show?", "options": ["Valid syntax does not guarantee correct semantics", "Grammar is absent", "Program cannot execute", "CPU changed the language"], "answer": 0, "section": "Language Evaluation"}, {"q": "Which expression represents (5 + 3) × 2?", "options": ["(+ 5 (* 3 2))", "(* (+ 5 3) 2)", "(* 5 (+ 3 2))", "(+ (* 5 3) 2)"], "answer": 1, "section": "Scheme & Lisp"}, {"q": "What is (+ 10 (* 3 (- 8 5)))?", "options": ["19", "39", "24", "45"], "answer": 0, "section": "Scheme & Lisp"}, {"q": "Which expression calculates the square of the sum of 4 and 6?", "options": ["(+ (* 4 4) (* 6 6))", "(* 4 (+ 6 6))", "(* (+ 4 6) (+ 4 6))", "(+ 4 (* 6 6))"], "answer": 2, "section": "Scheme & Lisp"}, {"q": "Why is (+ 5 3) Lisp-style notation?", "options": ["Arguments precede operator", "It must update a variable", "It is Python syntax", "Operator precedes arguments"], "answer": 3, "section": "Scheme & Lisp"}, {"q": "Given (define (square x) (* x x)), what is (square (+ 2 3))?", "options": ["25", "10", "13", "Error"], "answer": 0, "section": "Scheme & Lisp"}, {"q": "Given square, what is (+ (square 3) (square 4))?", "options": ["14", "49", "25", "24"], "answer": 2, "section": "Scheme & Lisp"}, {"q": "Which definition correctly creates double?", "options": ["(define double (* x 2))", "(define (double x) (* x 2))", "(double define x (* x 2))", "(define (double) (* x 2))"], "answer": 1, "section": "Scheme & Lisp"}, {"q": "Given double, what is (double (double 3))?", "options": ["9", "6", "18", "12"], "answer": 3, "section": "Scheme & Lisp"}, {"q": "What is (car (cdr '(10 20 30 40)))?", "options": ["10", "20", "(20 30 40)", "30"], "answer": 1, "section": "Scheme & Lisp"}, {"q": "What is (cdr (cdr '(5 10 15 20)))?", "options": ["(15 20)", "(10 15 20)", "(20)", "15"], "answer": 0, "section": "Scheme & Lisp"}, {"q": "What is (car (cons 5 '(10 20 30)))?", "options": ["10", "(5 10 20 30)", "5", "(10 20 30)"], "answer": 2, "section": "Scheme & Lisp"}, {"q": "What is (cons (car '(7 8 9)) (cdr '(1 2 3)))?", "options": ["(1 2 3)", "(7 8 9)", "(7 1 2 3)", "(7 2 3)"], "answer": 3, "section": "Scheme & Lisp"}, {"q": "Which expression produces (5 20 30) from (10 20 30)?", "options": ["(cons 5 (cdr '(10 20 30)))", "(car (cons 5 '(10 20 30)))", "(cdr (cons 5 '(10 20 30)))", "(cons 5 (car '(10 20 30)))"], "answer": 0, "section": "Scheme & Lisp"}, {"q": "What is (let ((x 10) (y 20)) (+ (* x 2) y))?", "options": ["30", "40", "50", "60"], "answer": 1, "section": "Scheme & Lisp"}, {"q": "What is (let ((x 5)) (let ((x 10)) (+ x 2)))?", "options": ["7", "5", "12", "17"], "answer": 2, "section": "Scheme & Lisp"}, {"q": "Given double, what is (let ((x 4)) (double (+ x 3)))?", "options": ["7", "8", "11", "14"], "answer": 3, "section": "Scheme & Lisp"}, {"q": "Given square, what is (let ((x 3) (y 4)) (+ (square x) (square y)))?", "options": ["14", "49", "24", "25"], "answer": 3, "section": "Scheme & Lisp"}];const WRITTEN=[{"q": "Write a Python program that accepts a student's mark and displays \"Pass\" if the mark is 60 or above; otherwise, display \"Fail\". Explain how the program works.", "answer": "mark = float(input(\"Enter student mark: \"))\nif mark >= 60:\n    print(\"Pass\")\nelse:\n    print(\"Fail\")\n\nThe condition checks whether the mark is at least 60. If true, the program prints Pass; otherwise, Fail."}, {"q": "A Python program executes without errors but produces an incorrect result. Analyze the difference between syntax errors and logical errors. Explain why successful execution does not guarantee a correct solution.", "answer": "Syntax errors break the rules of the language and usually prevent execution. Logical errors allow execution but produce the wrong answer.\n\nExample: if mark > 60: print(\"Pass\") incorrectly fails a student who gets exactly 60. Successful execution alone does not prove the requirements were met."}, {"q": "A university wants to develop a student management system. Evaluate imperative, object-oriented, and functional programming approaches. Which would you recommend? Justify your answer.", "answer": "Approach\tEvaluation\nImperative\tSuitable for implementing step-by-step operations such as calculating grades.\nObject-oriented\tSuitable for representing students, teachers, courses, and their relationships.\nFunctional\tSuitable for reusable calculations such as averages and grade transformations.\nRecommendation: Object-oriented programming is a suitable primary approach because students, courses, and teachers can be represented as objects containing data and related methods. Imperative and functional techniques can still be used within the system."}, {"q": "Consider the following Python statements:\nx = a * b\ntotal_price = price * quantity\nApply the concept of readability to explain which statement is easier to understand and why.", "answer": "The second statement is more readable because its variable names clearly describe the purpose of the calculation.\n•\ttotal_price describes the result.\n•\tprice describes the cost of one item.\n•\tquantity describes the number of items.\nBoth statements perform multiplication, but the second is easier to understand and maintain."}, {"q": "A company is choosing a programming language for a banking system. Analyze how readability, writability, reliability, and cost influence the decision.", "answer": "Criterion\tImportance for Banking Systems\nReadability\tHelps developers understand and maintain financial software.\nWritability\tMakes it easier to develop banking features and applications.\nReliability\tHelps ensure transactions are processed correctly and dependably.\nCost\tIncludes development, testing, training, and long-term maintenance.\nConclusion: All four criteria matter, but reliability is especially important because incorrect financial transactions can cause serious problems."}, {"q": "Language A is easy to learn and develop with but has high maintenance costs. Language B requires more training but provides strong reliability and lower long-term maintenance costs. Which language would you recommend for a long-term project?", "answer": "I would recommend Language B, assuming both languages meet the project's functional requirements.\nAlthough Language B requires more initial training, it offers two important advantages:\n1.\tStrong reliability, which supports dependable software.\n2.\tLower long-term maintenance costs, which can reduce overall project expenses.\nConclusion: Language B is more suitable for the long-term project because reliability and total lifecycle cost are more important than initial development convenience alone."}, {"q": "Write a Scheme function named square that calculates the square of a number. Then write a Scheme expression to calculate the sum of the squares of 3 and 4. Show the result.", "answer": "(define (square x) (* x x))\n(+ (square 3) (square 4))\n\nResult: 9 + 16 = 25."}, {"q": "Analyze the following Scheme expression. Explain how local binding and variable shadowing work and determine the final result.", "answer": "(let ((x 5)) (let ((x 10)) (+ x 2)))\n\nThe outer x is 5, but the inner x = 10 shadows it within the inner let. Result: 12."}, {"q": "Consider the following unsorted list of numbers:\n45, 20, 70, 10, 60, 30, 80, 25, 65\n1.\tConstruct a Binary Search Tree (BST) by inserting the numbers in the given order.\n2.\tInsert the value 55 into the constructed BST and show its correct position.\n3.\tSearch for the value 65 and show the path followed from the root.", "answer": "Initial BST: 45 is the root. Left subtree: 20 with left child 10 and right child 30 (whose left child is 25). Right subtree: 70 with left child 60 (left child 55 after insertion, right child 65) and right child 80.\n\nInsert 55: 45 → 70 → 60 → left.\nSearch 65: 45 → 70 → 60 → 65 (4 comparisons)."}];
let responses={},order=QUESTIONS.map((_,i)=>i),pos=0,selectedModule='All';const $=id=>document.getElementById(id);const el=(tag,cls,txt)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(txt!==undefined)e.textContent=txt;return e};
function currentOrder(){return order.filter(i=>selectedModule==='All'||QUESTIONS[i].section===selectedModule)}
function totals(){let entries=Object.entries(responses);return {attempted:entries.length,correct:entries.filter(([i,a])=>QUESTIONS[+i].answer===a).length}}
function render(){const ids=currentOrder();if(pos>=ids.length)pos=Math.max(0,ids.length-1);const id=ids[pos],q=QUESTIONS[id],given=responses[id];$('sectionLabel').textContent=q.section;$('numberLabel').textContent=`Question ${pos+1} of ${ids.length}`;$('prompt').textContent=q.q;$('options').replaceChildren();q.options.forEach((option,i)=>{let b=el('button','option');let key=el('b','',String.fromCharCode(65+i));b.append(key,el('span','',option));if(given!==undefined){b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===given)b.classList.add('wrong')}b.onclick=()=>{if(responses[id]!==undefined)return;responses[id]=i;render()};$('options').append(b)});$('feedback').classList.toggle('hidden',given===undefined);if(given!==undefined)$('feedback').textContent=(given===q.answer?'✓ Correct! Great work.':'✗ Not quite. The correct answer is '+String.fromCharCode(65+q.answer)+'.')+'  '+q.options[q.answer];let answered=ids.filter(i=>responses[i]!==undefined).length;$('bar').style.width=(100*answered/ids.length)+'%';$('progressText').textContent=`${answered} of ${ids.length} answered · ${ids.length-answered} remaining`;$('prev').disabled=pos===0;$('next').textContent=pos===ids.length-1?'View results →':'Next question →';let t=totals();$('scoreTop').textContent=`${t.correct} / ${t.attempted}`;renderResults()}
function renderResults(){let t=totals();$('finalScore').textContent=t.attempted?Math.round(t.correct/t.attempted*100)+'%':'0%';$('resultText').textContent=t.attempted?`${t.correct} correct out of ${t.attempted} attempted. ${47-t.attempted} questions not yet attempted.`:'Answer some questions to see your results.';let d=$('breakdown');d.replaceChildren();['Foundations','Language Evaluation','Scheme & Lisp'].forEach(s=>{let ids=QUESTIONS.map((q,i)=>q.section===s?i:-1).filter(i=>i>=0),done=ids.filter(i=>responses[i]!==undefined),correct=done.filter(i=>responses[i]===QUESTIONS[i].answer);d.append(el('p','',`${s}: ${correct.length} correct / ${done.length} attempted (${ids.length} total)`))})}
function switchTab(tab){document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));['quiz','written','results'].forEach(t=>$(t).classList.toggle('hidden',t!==tab));if(tab==='results')renderResults()}
document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>switchTab(b.dataset.tab));$('module').onchange=e=>{selectedModule=e.target.value;pos=0;render()};$('next').onclick=()=>{if(pos<currentOrder().length-1){pos++;render()}else switchTab('results')};$('prev').onclick=()=>{pos=Math.max(0,pos-1);render()};$('shuffle').onclick=()=>{for(let i=order.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[order[i],order[j]]=[order[j],order[i]]}pos=0;render()};function reset(){if(!confirm('Clear all MCQ answers and start again?'))return;responses={};pos=0;render();switchTab('quiz')}$('restart').onclick=reset;$('resetResults').onclick=reset;$('review').onclick=()=>switchTab('quiz');WRITTEN.forEach((item,i)=>{let d=el('details'),sum=el('summary','',`Task ${i+1}: ${item.q}`),ta=el('textarea');ta.placeholder='Write your answer here before viewing the suggested solution...';let btn=el('button','smallbtn','Reveal suggested answer'),answer=el('div','answer hidden',item.answer);btn.onclick=()=>{answer.classList.toggle('hidden');btn.textContent=answer.classList.contains('hidden')?'Reveal suggested answer':'Hide suggested answer'};d.append(sum,ta,btn,answer);$('writtenList').append(d)});render();
</script></body></html>
